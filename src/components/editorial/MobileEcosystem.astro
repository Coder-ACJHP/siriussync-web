---
import { ArrowUpRight } from 'lucide-react';

interface Props {
  lang?: 'en' | 'tr';
}

const { lang = 'en' } = Astro.props;

const t = {
  en: {
    sectionNum: '02 / MOBILE ECOSYSTEM',
    headline: 'Native iOS utilities & intelligent apps.',
    desc: 'High-performance mobile applications with on-device machine learning, computer vision, and in-app purchase infrastructure.',
    viewAppStore: 'View on App Store',
    apps: [
      {
        title: 'Cleanjet: AI iPhone Cleaner',
        category: 'SMART UTILITY & STORAGE OPTIMIZATION',
        desc: 'Intelligent on-device storage optimization utilizing pHash perceptual hashing and Apple Vision framework to detect duplicate media, compress bloated albums, and restore storage safely.',
        stack: ['Swift', 'Vision Framework', 'pHash Algorithm', 'RevenueCat', 'StoreKit 2'],
        image: '/assets/images/cleanjet.png',
        link: 'https://apps.apple.com/us/app/cleanjet-ai-phone-cleaner/id6749763106',
        btnText: 'View on App Store',
      },
      {
        title: 'Anylight AI Photo Editor',
        category: 'CREATIVE AI & COMPUTER VISION',
        desc: 'High-performance native iOS photo editor combining Apple CoreML neural models and custom OpenCV shaders for neural relighting, real-time exposure balance, and artifact elimination.',
        stack: ['UIKit', 'CoreML', 'OpenCV', 'CoreImage', 'Alamofire'],
        image: '/assets/images/anylight.png',
        link: 'https://apps.apple.com/us/app/anylight-ai-photo-editor/id1523192876',
        btnText: 'View on App Store',
      },
      {
        title: 'Babybell — Pregnancy & Health Tracking',
        category: 'HEALTHCARE & MATERNAL MONITORING',
        desc: 'Comprehensive pregnancy tracking companion providing weekly fetal growth analytics, clinical vital metric logging, and seamless multimedia playback for expectant families.',
        stack: ['UIKit', 'Alamofire', 'AVKit', 'CoreData', 'Local Notifications'],
        image: '/assets/images/babybell.png',
        link: 'https://babybell.app/',
        btnText: 'Visit babybell.app',
      },
    ],
  },
  tr: {
    sectionNum: '02 / MOBİL EKOSİSTEM',
    headline: 'Native iOS araçları ve akıllı mobil uygulamalar.',
    desc: 'Cihaz içi makine öğrenimi, bilgisayarlı görü ve mağaza abonelik mimarileriyle geliştirilmiş popüler mobil uygulamalar.',
    viewAppStore: 'App Store’da İncele',
    apps: [
      {
        title: 'Cleanjet: AI iPhone Cleaner',
        category: 'AKILLI DEPOLAMA & GÖRÜNTÜ ANALİZİ',
        desc: 'Apple Vision framework ve pHash algoritmalarını cihaz üzerinde çalıştırarak benzer/kopya fotoğrafları tespit eden, depolamayı güvenle optimize eden akıllı analiz aracı.',
        stack: ['Swift', 'Vision Framework', 'pHash Algoritması', 'RevenueCat', 'StoreKit 2'],
        image: '/assets/images/cleanjet.png',
        link: 'https://apps.apple.com/us/app/cleanjet-ai-phone-cleaner/id6749763106',
        btnText: 'App Store’da İncele',
      },
      {
        title: 'Anylight AI Photo Editor',
        category: 'YAPAY ZEKA DESTEKLİ FOTOĞRAF DÜZENLEME',
        desc: 'CoreML sinir ağı modelleri ve optimize edilmiş OpenCV filtreleri ile fotoğraflarda yapay ışıklandırma, dinamik pozlama ve doku temizliği sağlayan native iOS stüdyosu.',
        stack: ['UIKit', 'CoreML', 'OpenCV', 'CoreImage', 'Alamofire'],
        image: '/assets/images/anylight.png',
        link: 'https://apps.apple.com/us/app/anylight-ai-photo-editor/id1523192876',
        btnText: 'App Store’da İncele',
      },
      {
        title: 'Babybell — Gebelik & Sağlık Takibi',
        category: 'SAĞLIK & ANNE-BEBEK TAKİBİ',
        desc: 'Hamilelik süreci boyunca haftalık bebek gelişimini görselleştiren, sağlık ölçümlerini kayıt altına alan ve uzman rehberliği sunan kapsamlı takip platformu.',
        stack: ['UIKit', 'Alamofire', 'AVKit', 'CoreData', 'Yerel Bildirimler'],
        image: '/assets/images/babybell.png',
        link: 'https://babybell.app/',
        btnText: 'babybell.app’i Ziyaret Et',
      },
    ],
  },
}[lang];
---

<section class="py-24 px-6 md:px-12 border-b border-blue-500/15 bg-[#090d16]">
  <div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div>
        <span class="text-xs font-mono tracking-widest text-cyan-400 font-semibold uppercase block mb-3">
          {t.sectionNum}
        </span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white max-w-xl leading-tight">
          {t.headline}
        </h2>
      </div>
      <p class="text-sm text-zinc-400 max-w-md font-normal leading-relaxed">
        {t.desc}
      </p>
    </div>

    <!-- Apps Editorial Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        t.apps.map((app) => (
          <div class="rounded-3xl border border-zinc-800 bg-[#0c121e] flex flex-col justify-between overflow-hidden group glow-card">
            <div class="editorial-img-container h-60 bg-zinc-950 p-4 border-b border-zinc-800 flex items-center justify-center">
              <img
                src={app.image}
                alt={app.title}
                class="w-full h-full object-cover rounded-xl"
              />
            </div>
            <div class="p-6 sm:p-8 flex-1 flex flex-col justify-between space-y-6">
              <div>
                <span class="text-[10px] font-mono tracking-widest text-blue-400 font-bold uppercase block mb-2">
                  {app.category}
                </span>
                <h3 class="text-xl font-bold tracking-tight text-white mb-3 group-hover:text-blue-300 transition-colors">
                  {app.title}
                </h3>
                <p class="text-xs text-zinc-300 font-normal leading-relaxed">
                  {app.desc}
                </p>
              </div>

              <div>
                <div class="flex flex-wrap gap-1.5 text-[11px] font-mono text-zinc-300 mb-6">
                  {app.stack.map((item) => (
                    <span class="px-2 py-1 rounded-md bg-zinc-900 border border-zinc-700/80">{item}</span>
                  ))}
                </div>

                <a
                  href={app.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-xs font-mono tracking-wider uppercase text-blue-400 hover:text-cyan-300 transition-colors pt-3 border-t border-zinc-800 w-full justify-between font-bold"
                >
                  <span>{app.btnText || t.viewAppStore}</span>
                  <ArrowUpRight className="w-4 h-4 text-blue-400" />
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
