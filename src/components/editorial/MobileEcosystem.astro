---
import { ArrowUpRight } from 'lucide-react';

interface Props {
  lang?: 'en' | 'tr';
}

const { lang = 'en' } = Astro.props;

const t = {
  en: {
    sectionNum: '02 / MOBILE ECOSYSTEM',
    headline: 'Autonomous iOS utilities & intelligent apps.',
    desc: 'Native iOS engineering with advanced machine learning, computer vision, and revenue infrastructure shipped to the App Store.',
    viewAppStore: 'App Store Profile / Releases',
    apps: [
      {
        title: 'Cleanjet: AI iPhone Cleaner',
        category: 'SMART UTILITY & STORAGE OPTIMIZATION',
        desc: 'Intelligent on-device storage optimization utilizing pHash perceptual hashing and Apple Vision framework to detect duplicate media, compress bloated albums, and restore storage safely.',
        stack: ['Swift', 'Vision Framework', 'pHash Algorithm', 'RevenueCat', 'StoreKit 2'],
        image: '/assets/images/cleanjet.png',
        link: 'https://apps.apple.com/developer/onur-isik', // App Store link
      },
      {
        title: 'Anylight AI Photo Editor',
        category: 'CREATIVE AI & COMPUTER VISION',
        desc: 'High-performance native iOS photo editor combining Apple CoreML neural models and custom OpenCV shaders for neural relighting, real-time exposure balance, and artifact elimination.',
        stack: ['UIKit', 'CoreML', 'OpenCV', 'CoreImage', 'Alamofire'],
        image: '/assets/images/anylight.png',
        link: 'https://apps.apple.com/developer/onur-isik',
      },
      {
        title: 'Babybell — Pregnancy & Health Tracking',
        category: 'HEALTHCARE & MATERNAL MONITORING',
        desc: 'Comprehensive pregnancy tracking companion providing weekly fetal growth analytics, clinical vital metric logging, and seamless multimedia playback for expectant families.',
        stack: ['UIKit', 'Alamofire', 'AVKit', 'CoreData', 'Local Notifications'],
        image: '/assets/images/babybell.png',
        link: 'https://apps.apple.com/developer/onur-isik',
      },
    ],
  },
  tr: {
    sectionNum: '02 / MOBİL EKOSİSTEM',
    headline: 'Bağımsız iOS araçları ve yapay zeka uygulamaları.',
    desc: 'Makine öğrenimi, bilgisayarlı görü ve abonelik altyapılarıyla donatılmış, App Store üzerinde yayınlanmış native iOS mühendisliği.',
    viewAppStore: 'App Store Profili & İndir',
    apps: [
      {
        title: 'Cleanjet: AI iPhone Cleaner',
        category: 'AKILLI DEPOLAMA & GÖRÜNTÜ ANALİZİ',
        desc: 'Apple Vision framework ve pHash algoritmalarını cihaz üzerinde çalıştırarak benzer/kopya fotoğrafları tespit eden, depolamayı güvenle optimize eden akıllı analiz aracı.',
        stack: ['Swift', 'Vision Framework', 'pHash Algoritması', 'RevenueCat', 'StoreKit 2'],
        image: '/assets/images/cleanjet.png',
        link: 'https://apps.apple.com/developer/onur-isik',
      },
      {
        title: 'Anylight AI Photo Editor',
        category: 'YAPAY ZEKA DESTEKLİ FOTOĞRAF DÜZENLEME',
        desc: 'CoreML sinir ağı modelleri ve optimize edilmiş OpenCV filtreleri ile fotoğraflarda yapay ışıklandırma, dinamik pozlama ve doku temizliği sağlayan native iOS stüdyosu.',
        stack: ['UIKit', 'CoreML', 'OpenCV', 'CoreImage', 'Alamofire'],
        image: '/assets/images/anylight.png',
        link: 'https://apps.apple.com/developer/onur-isik',
      },
      {
        title: 'Babybell — Gebelik & Sağlık Takibi',
        category: 'SAĞLIK & ANNE-BEBEK TAKİBİ',
        desc: 'Hamilelik süreci boyunca haftalık bebek gelişimini görselleştiren, sağlık ölçümlerini kayıt altına alan ve uzman rehberliği sunan kapsamlı takip platformu.',
        stack: ['UIKit', 'Alamofire', 'AVKit', 'CoreData', 'Yerel Bildirimler'],
        image: '/assets/images/babybell.png',
        link: 'https://apps.apple.com/developer/onur-isik',
      },
    ],
  },
}[lang];
---

<section id="works" class="py-24 px-6 md:px-12 hairline-b bg-[#050507]">
  <div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div>
        <span class="text-xs font-mono tracking-widest text-zinc-500 uppercase block mb-3">
          {t.sectionNum}
        </span>
        <h2 class="text-3xl sm:text-5xl font-editorial tracking-tight text-white max-w-xl leading-none">
          {t.headline}
        </h2>
      </div>
      <p class="text-sm text-zinc-400 max-w-md font-light leading-relaxed">
        {t.desc}
      </p>
    </div>

    <!-- Apps Editorial Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        t.apps.map((app) => (
          <div class="rounded-3xl hairline bg-[#08080a] flex flex-col justify-between overflow-hidden group hover:border-white/20 transition-all">
            <div class="editorial-img-container h-60 bg-zinc-950 p-4 border-b border-white/5 flex items-center justify-center">
              <img
                src={app.image}
                alt={app.title}
                class="w-full h-full object-cover rounded-xl"
              />
            </div>
            <div class="p-6 sm:p-8 flex-1 flex flex-col justify-between space-y-6">
              <div>
                <span class="text-[10px] font-mono tracking-widest text-zinc-500 uppercase block mb-2">
                  {app.category}
                </span>
                <h3 class="text-xl font-editorial tracking-tight text-white mb-3">
                  {app.title}
                </h3>
                <p class="text-xs text-zinc-400 font-light leading-relaxed">
                  {app.desc}
                </p>
              </div>

              <div>
                <div class="flex flex-wrap gap-1.5 text-[11px] font-mono text-zinc-400 mb-6">
                  {app.stack.map((item) => (
                    <span class="px-2 py-1 rounded bg-zinc-900 hairline">{item}</span>
                  ))}
                </div>

                <a
                  href={app.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-xs font-mono tracking-wider uppercase text-white hover:text-zinc-300 transition-colors pt-2 border-t border-white/5 w-full justify-between"
                >
                  <span>{t.viewAppStore}</span>
                  <ArrowUpRight className="w-3.5 h-3.5 text-zinc-400" />
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

