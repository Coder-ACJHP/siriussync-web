---
import FluidCanvas from '../canvas/FluidCanvas';
import { ArrowDown, Mail } from 'lucide-react';

interface Props {
  lang?: 'en' | 'tr';
}

const { lang = 'en' } = Astro.props;

const content = {
  en: {
    statusBadge: 'FREELANCE SOFTWARE & SENIOR ENGINEERING',
    headline: 'From idea to production: scalable, maintainable, and reliable software.',
    description:
      "I've been building software for mobile, web, and desktop for 11 years, and I've specialized in iOS apps for the last 8. I've taken more than 20 projects from concept to launch.",
    exploreBtn: 'Explore Projects',
    contactBtn: 'Direct Inquiries',
    metaLocation: 'ISTANBUL, TR',
    metaFocus: 'MOBILE • DESKTOP • WEB',
  },
  tr: {
    statusBadge: 'FREELANCE YAZILIM & KIDEMLİ MÜHENDİSLİK',
    headline: 'Fikirlerinizi sürdürülebilir, ölçeklenebilir ve güvenilir yazılım çözümlerine dönüştürüyorum.',
    description:
      '11 yıldır mobil, web ve masaüstü için yazılım geliştiriyorum. Son 8 yılda uzmanlığım iOS uygulamaları oldu. 20\'den fazla projeyi baştan sona geliştirdim.',
    exploreBtn: 'Projeleri İncele',
    contactBtn: 'İletişime Geç',
    metaLocation: 'İSTANBUL, TR',
    metaFocus: 'MOBİL • MASAÜSTÜ • WEB',
  },
}[lang];
---

<section class="relative pt-24 pb-20 md:pt-36 md:pb-32 px-6 md:px-12 overflow-hidden border-b border-blue-500/15">
  <!-- Interactive WebGL Canvas with Cyan & Blue particles -->
  <FluidCanvas client:load />

  <!-- Ambient Blue Gradient Light Source -->
  <div class="absolute -top-32 -left-32 w-96 h-96 bg-blue-600/15 rounded-full blur-[140px] pointer-events-none"></div>
  <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-cyan-500/10 rounded-full blur-[140px] pointer-events-none"></div>

  <div class="relative z-10 max-w-6xl mx-auto">
    <!-- Meta details bar -->
    <div class="flex flex-wrap items-center justify-between gap-4 pb-8 mb-8 border-b border-zinc-800 text-xs font-mono text-zinc-400 uppercase tracking-widest">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/25 text-blue-400">
        <span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>
        <span>{content.statusBadge}</span>
      </div>
      <div class="flex items-center text-zinc-400">
        <span class="text-white font-medium">{content.metaFocus}</span>
      </div>
    </div>

    <!-- Clear, Powerful Sans Headline (No Serif) -->
    <div class="max-w-4xl mb-8">
      <h1 class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.12]">
        {lang === 'tr' ? (
          <>
            Fikirlerinizi <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-cyan-300 to-blue-500">sürdürülebilir, ölçeklenebilir</span> ve güvenilir yazılım çözümlerine dönüştürüyorum.
          </>
        ) : (
          <>
            From idea to production: <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-cyan-300 to-blue-500">scalable, maintainable</span>, and reliable software.
          </>
        )}
      </h1>
    </div>

    <!-- Description & Action Buttons -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-end pt-2">
      <div class="md:col-span-8">
        <p class="text-base sm:text-lg md:text-xl text-zinc-300 font-normal leading-relaxed max-w-2xl">
          {content.description}
        </p>
      </div>
      <div class="md:col-span-4 flex flex-col sm:flex-row md:flex-col gap-3 justify-end">
        <a
          href="#works"
          class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full text-xs font-mono uppercase tracking-wider bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-600/30 transition-all font-bold"
        >
          <span>{content.exploreBtn}</span>
          <ArrowDown className="w-4 h-4 text-blue-200" />
        </a>
        <a
          href="#contact"
          class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full text-xs font-mono uppercase tracking-wider border border-zinc-700 bg-zinc-900/60 hover:bg-zinc-800 text-zinc-200 hover:text-white transition-all font-medium"
        >
          <Mail className="w-4 h-4 text-zinc-400" />
          <span>{content.contactBtn}</span>
        </a>
      </div>
    </div>
  </div>
</section>
