---
interface Props {
  lang?: 'en' | 'tr';
}

const { lang = 'en' } = Astro.props;

const t = {
  en: {
    sectionNum: '03 / TECHNICAL CAPABILITIES',
    headline: 'Multi-platform engineering & core competencies.',
    desc: 'Battle-tested across 11+ years of software development. Pragmatic, framework-agnostic problem solving across mobile, desktop, and web ecosystems.',
    pillars: [
      {
        category: 'MOBILE DEVELOPMENT',
        desc: 'Native iOS & Cross-Platform Mobile',
        skills: ['iOS (Swift, SwiftUI, UIKit)', 'Android (Kotlin, Java)', 'CoreML & Apple Vision', 'StoreKit & In-App Purchases', 'App Store & Play Store Lifecycle'],
        badge: 'PRIMARY',
        color: 'text-blue-400 border-blue-500/30 bg-blue-500/10',
      },
      {
        category: 'DESKTOP SYSTEMS',
        desc: 'macOS & Windows Architecture',
        skills: ['Java 17/21 LTS & JavaFX', 'Cross-Platform UI/UX', 'JPackage Native Installers (.dmg, .msi)', 'Hardware Licensing (HWID)', 'Modular Maven Lifecycle'],
        badge: 'SECONDARY',
        color: 'text-cyan-400 border-cyan-500/30 bg-cyan-500/10',
      },
      {
        category: 'MODERN WEB & APIS',
        desc: 'Scalable Full-Stack Engineering',
        skills: ['Modern Frontend Frameworks', 'RESTful API & WebSockets', 'High-Performance Static / SSR', 'Micro-Interactions & Motion', 'Cloudflare Edge Infrastructure'],
        badge: 'EXPANDED',
        color: 'text-emerald-400 border-emerald-500/30 bg-emerald-500/10',
      },
      {
        category: 'CLOUD & PERSISTENCE',
        desc: 'Data Reliability & Security Posture',
        skills: ['Supabase Cloud & Realtime', 'PostgreSQL & RLS Policies', 'Bcrypt Encryption & Auth', 'Firebase Infrastructure', 'Relational Schema Design'],
        badge: 'SECURE',
        color: 'text-indigo-400 border-indigo-500/30 bg-indigo-500/10',
      },
    ],
  },
  tr: {
    sectionNum: '03 / TEKNİK YETKİNLİKLER',
    headline: 'Çok platformlu mühendislik ve uzmanlık matrisi.',
    desc: '11 yılı aşkın yazılım tecrübesiyle pekiştirilmiş; dil ve teknoloji taraftarlığından uzak, probleme en doğru aracı seçen pragmatik mühendislik yaklaşımı.',
    pillars: [
      {
        category: 'MOBİL GELİŞTİRME',
        desc: 'Native iOS ve Android Uygulamaları',
        skills: ['iOS (Swift, SwiftUI, UIKit)', 'Android (Kotlin, Java)', 'CoreML & Apple Vision', 'StoreKit & Abonelik Sistemleri', 'App Store & Play Store Dağıtımı'],
        badge: 'ASIL BRANŞ',
        color: 'text-blue-400 border-blue-500/30 bg-blue-500/10',
      },
      {
        category: 'MASAÜSTÜ YAZILIM',
        desc: 'macOS ve Windows Kurumsal Çözümler',
        skills: ['Java 17/21 LTS & JavaFX', 'Çapraz Platform GUI Mimarisi', 'Native Paketleme (.dmg, .msi)', 'Donanım Lisanslama (HWID)', 'Maven Modüler Derleme'],
        badge: '2. BRANŞ',
        color: 'text-cyan-400 border-cyan-500/30 bg-cyan-500/10',
      },
      {
        category: 'MODERN WEB & API',
        desc: 'Ölçeklenebilir Web Mimarileri',
        skills: ['Modern Web Arayüzleri', 'RESTful API & WebSocket', 'Yüksek Performanslı Web Çözümleri', 'Mikro-Etkileşim & Animasyon', 'Cloudflare Edge Altyapısı'],
        badge: 'GENİŞ KAPSAM',
        color: 'text-emerald-400 border-emerald-500/30 bg-emerald-500/10',
      },
      {
        category: 'VERİTABANI & BULUT',
        desc: 'Veri Güvenliği ve Altyapı',
        skills: ['Supabase Cloud & Realtime', 'PostgreSQL & RLS Güvenlik İlkeleri', 'Bcrypt Şifreleme & Kimlik', 'Firebase Entegrasyonları', 'İlişkisel Veri Modelleme'],
        badge: 'GÜVENLİ',
        color: 'text-indigo-400 border-indigo-500/30 bg-indigo-500/10',
      },
    ],
  },
}[lang];
---

<section id="expertise" class="py-24 px-6 md:px-12 border-b border-blue-500/15 bg-[#07090e]">
  <div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div>
        <span class="text-xs font-mono tracking-widest text-blue-400 font-semibold uppercase block mb-3">
          {t.sectionNum}
        </span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white max-w-xl leading-tight">
          {t.headline}
        </h2>
      </div>
      <p class="text-sm text-zinc-400 max-w-md font-normal leading-relaxed">
        {t.desc}
      </p>
    </div>

    <!-- Pillars Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        t.pillars.map((pillar) => (
          <div class="p-6 sm:p-8 rounded-3xl border border-zinc-800 bg-[#0c121e] flex flex-col justify-between h-full glow-card">
            <div>
              <div class="flex justify-between items-center mb-4">
                <span class={`text-[10px] font-mono tracking-widest uppercase px-2.5 py-1 rounded-full border ${pillar.color} font-bold`}>
                  {pillar.badge}
                </span>
                <span class="w-2 h-2 rounded-full bg-blue-500/60"></span>
              </div>
              <h3 class="text-lg font-bold text-white tracking-tight mb-1">
                {pillar.category}
              </h3>
              <p class="text-xs text-zinc-400 mb-6 font-mono">
                {pillar.desc}
              </p>
            </div>

            <ul class="space-y-3 pt-4 border-t border-zinc-800/80">
              {pillar.skills.map((skill) => (
                <li class="text-xs font-mono text-zinc-300 flex items-center gap-2">
                  <span class="text-blue-400">›</span>
                  <span>{skill}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
