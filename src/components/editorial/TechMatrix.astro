---
interface Props {
  lang?: 'en' | 'tr';
}

const { lang = 'en' } = Astro.props;

const t = {
  en: {
    sectionNum: '03 / TECHNICAL CAPABILITIES',
    headline: 'Multi-platform engineering & core competencies.',
    desc: 'Battle-tested across 11+ years of software development. Pragmatic, framework-agnostic problem solving across mobile, desktop, and web ecosystems.',
    pillars: [
      {
        category: 'MOBILE APPS',
        desc: 'For iPhone and Android, from your idea to the store launch',
        skills: [
          'Education, Entertainment, Productivity',
          'Travel (Location and Maps)',
          'Social Networking (Messaging)',
          'Health and Fitness',
          'Assistants and Helpers',
          'Payments, Subscriptions, Notifications',
          'Publishing Process',
        ],
        badge: 'Mobile',
        color: 'text-blue-400 border-blue-500/30 bg-blue-500/10',
      },
      {
        category: 'DESKTOP SOFTWARE',
        desc: 'Solutions for macOS and Windows',
        skills: [
          'Inventory and Stock Tracking',
          'Customer Relationship Management (CRM)',
          'Productivity',
          'Task Management',
          'Progress Tracking',
          'Tools That Make Your Work Easier',
          'Modular, Cross-Platform',
        ],
        badge: 'Desktop',
        color: 'text-cyan-400 border-cyan-500/30 bg-cyan-500/10',
      },
      {
        category: 'WEBSITE & WEB APP',
        desc: 'Fast, secure web solutions built to grow with you',
        skills: [
          'Business Sites, Personal Sites, Portfolios',
          'Online Ordering & Sales (WhatsApp orders, QR menus)',
          'Admin Dashboards (products, orders, customers)',
          'User Accounts & Login',
          'Fast-Loading, Mobile-Friendly Design',
          'Smooth Animations & Modern Interface',
          'Domain, Hosting & Launch',
        ],
        badge: 'Web',
        color: 'text-emerald-400 border-emerald-500/30 bg-emerald-500/10',
      },
      {
        category: 'CLOUD & DATA SECURITY',
        desc: 'Your data stays safe and up to date on every device',
        skills: [
          'Real-Time Sync Across Phone, Tablet and Computer',
          'Secure Login & Password Protection',
          'Role-Based Access (everyone sees only what they’re allowed to)',
          'Reliable Data Storage',
          'Infrastructure That Grows With Your Users',
          'Supabase, Firebase, SQLite, MySQL',
        ],
        badge: 'Cloud & Security',
        color: 'text-indigo-400 border-indigo-500/30 bg-indigo-500/10',
      },
    ],
  },
  tr: {
    sectionNum: '03 / TEKNİK YETKİNLİKLER',
    headline: 'Çok platformlu mühendislik ve uzmanlık matrisi.',
    desc: '11 yılı aşkın yazılım tecrübesiyle pekiştirilmiş; dil ve teknoloji taraftarlığından uzak, probleme en doğru aracı seçen pragmatik mühendislik yaklaşımı.',
    pillars: [
      {
        category: 'MOBİL UYGULAMA',
        desc: 'iPhone ve Android için, fikrinizden mağazada yayına kadar',
        skills: [
          'Eğitim, Eğlence, Üretkenlik',
          'Seyahat (Konum ve Harita)',
          'Sosyal Ağ (Mesajlaşma)',
          'Sağlık ve Fitness',
          'Asistan, Yardımcılar',
          'Ödeme, Abonelik, Bildirimler',
          'Yayınlama Süreci',
        ],
        badge: 'Mobil',
        color: 'text-blue-400 border-blue-500/30 bg-blue-500/10',
      },
      {
        category: 'MASAÜSTÜ YAZILIM',
        desc: 'MacOS ve Windows için çözümler',
        skills: [
          'Envanter, Stok Takip',
          'Müşteri İlişkileri Yönetimi',
          'Üretkenlik',
          'Görev Yönetimi',
          'İlerleme İzleme',
          'İşinizi Kolaylaştıran',
          'Modüler, Çapraz Platform',
        ],
        badge: 'Masaüstü',
        color: 'text-cyan-400 border-cyan-500/30 bg-cyan-500/10',
      },
      {
        category: 'WEB SİTESİ VE UYGULAMA',
        desc: 'Hızlı, güvenli, büyümeye hazır web çözümleri',
        skills: [
          'Kurumsal Site, Kişisel Site, Portfolyo',
          'Online Sipariş ve Satış Sitesi (WhatsApp’a sipariş, QR menü)',
          'Yönetim Paneli (ürün, sipariş, müşteri takibi)',
          'Üyelik ve Giriş Sistemi',
          'Hızlı Açılan, Telefonda Kusursuz Görünen Tasarım',
          'Akıcı Animasyonlar ve Modern Arayüz',
          'Alan Adı, Barındırma ve Yayına Alma',
        ],
        badge: 'Web',
        color: 'text-emerald-400 border-emerald-500/30 bg-emerald-500/10',
      },
      {
        category: 'BULUT VE VERİ GÜVENLİĞİ',
        desc: 'Verileriniz güvende, her cihazda anında güncel',
        skills: [
          'Telefon, Tablet ve Bilgisayar Arasında Anlık Senkronizasyon',
          'Güvenli Giriş ve Şifre Koruması',
          'Kullanıcıya Özel Veri Erişimi (herkes sadece kendi yetkisi dahilindekini görür)',
          'Düzenli ve Güvenilir Veri Saklama',
          'Kullanıcı Sayınız Arttıkça Büyüyen Altyapı',
          'Supabase, Firebase, SQLite, MySQL',
        ],
        badge: 'Bulut ve Güvenlik',
        color: 'text-indigo-400 border-indigo-500/30 bg-indigo-500/10',
      },
    ],
  },
}[lang];
---

<section id="expertise" class="py-24 px-6 md:px-12 border-b border-blue-500/15 bg-[#07090e]">
  <div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div>
        <span class="text-xs font-mono tracking-widest text-blue-400 font-semibold uppercase block mb-3">
          {t.sectionNum}
        </span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white max-w-xl leading-tight">
          {t.headline}
        </h2>
      </div>
      <p class="text-sm text-zinc-400 max-w-md font-normal leading-relaxed">
        {t.desc}
      </p>
    </div>

    <!-- Pillars Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 sm:gap-6">
      {
        t.pillars.map((pillar) => (
          <div class="p-5 sm:p-6 rounded-3xl border border-zinc-800 bg-[#0c121e] flex flex-col h-full glow-card">
            <div>
              <div class="flex justify-between items-center mb-3">
                <span class={`text-[10px] font-mono tracking-widest uppercase px-2.5 py-1 rounded-full border ${pillar.color} font-bold`}>
                  {pillar.badge}
                </span>
                <span class="w-2 h-2 rounded-full bg-blue-500/60"></span>
              </div>
              <h3 class="text-sm sm:text-[15px] font-bold text-white tracking-tight mb-1.5 whitespace-nowrap">
                {pillar.category}
              </h3>
              <p class="text-xs text-zinc-400 font-mono h-10 leading-5 mb-4 line-clamp-2">
                {pillar.desc}
              </p>
            </div>

            <ul class="space-y-2.5 pt-4 border-t border-zinc-800/80">
              {pillar.skills.map((skill) => (
                <li class="text-xs font-mono text-zinc-300 flex items-start gap-2">
                  <span class="text-blue-400 shrink-0 mt-0.5">›</span>
                  <span>{skill}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
