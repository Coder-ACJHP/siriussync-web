---
interface Props {
  lang?: 'en' | 'tr';
}

const { lang = 'en' } = Astro.props;

const metrics = {
  en: [
    { label: 'ENGINEERING PRACTICE', value: '11+ Yrs', desc: '8 Yrs Professional • 3 Yrs Freelance', color: 'text-blue-400' },
    { label: 'COMPLETED PROJECTS', value: '20+', desc: 'Mobile, Desktop & Web', color: 'text-cyan-400' },
    { label: 'CORE EXPERTISE', value: 'Full-Stack', desc: 'iOS • Java Desktop • Modern Web', color: 'text-emerald-400' },
  ],
  tr: [
    { label: 'MÜHENDİSLİK PRATİĞİ', value: '11+ Yıl', desc: '8 Yıl Profesyonel • 3 Yıl Freelance', color: 'text-blue-400' },
    { label: 'TAMAMLANAN PROJELER', value: '20+', desc: 'Mobil, Masaüstü ve Web', color: 'text-cyan-400' },
    { label: 'TEMEL UZMANLIK', value: 'Tam Kapsam', desc: 'iOS • Java Masaüstü • Modern Web', color: 'text-emerald-400' },
  ],
}[lang];
---

<section class="border-b border-blue-500/15 bg-[#0b0f19]">
  <div class="max-w-6xl mx-auto px-6 md:px-12 py-10">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-8">
      {
        metrics.map((m) => (
          <div class="flex flex-col justify-between p-4 rounded-2xl bg-zinc-900/40 border border-zinc-800/60">
            <span class="text-[10px] font-mono tracking-widest text-zinc-400 uppercase mb-2">
              {m.label}
            </span>
            <div class={`text-3xl sm:text-4xl font-extrabold tracking-tight my-1 ${m.color}`}>
              {m.value}
            </div>
            <span class="text-xs text-zinc-400 font-normal">
              {m.desc}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>
