---
interface Props {
  lang?: 'en' | 'tr';
  currentSlug?: string;
}

const { lang = 'en', currentSlug = '' } = Astro.props;

const enUrl = currentSlug ? `/works/${currentSlug}` : '/';
const trUrl = currentSlug ? `/tr/works/${currentSlug}` : '/tr/';

const nav = {
  en: {
    works: 'Works',
    stack: 'Expertise',
    contact: 'Contact',
    getInTouch: 'Get in Touch',
  },
  tr: {
    works: 'Çalışmalar',
    stack: 'Yetkinlikler',
    contact: 'İletişim',
    getInTouch: 'İletişime Geç',
  },
}[lang];
---

<header class="sticky top-0 z-50 bg-[#07090e]/85 backdrop-blur-md border-b border-blue-500/15">
  <div class="max-w-6xl mx-auto px-6 md:px-12 h-20 flex items-center justify-between">
    <!-- Brand -->
    <a href={lang === 'en' ? '/' : '/tr/'} class="group flex items-center gap-3">
      <div class="w-9 h-9 rounded-xl border border-blue-500/30 flex items-center justify-center font-mono text-xs font-bold text-blue-400 bg-blue-500/10 group-hover:bg-blue-600 group-hover:text-white transition-all shadow-lg shadow-blue-500/10">
        OI
      </div>
      <div class="flex flex-col">
        <span class="text-sm font-bold tracking-tight text-white group-hover:text-blue-400 transition-colors">
          Onur Işık
        </span>
        <span class="text-[11px] font-mono text-cyan-400/80 tracking-wider">
          CODER ACJHP
        </span>
      </div>
    </a>

    <!-- Nav Links (Center: Works, Expertise, Contact) -->
    <nav class="hidden md:flex items-center gap-8 text-xs font-mono tracking-wider uppercase text-zinc-400">
      <a href="#works" class="hover:text-white transition-colors">{nav.works}</a>
      <a href="#expertise" class="hover:text-white transition-colors">{nav.stack}</a>
      <a href="#contact" class="hover:text-white transition-colors">{nav.contact}</a>
    </nav>

    <!-- Language Switcher & Direct CTA -->
    <div class="flex items-center gap-4">
      <div class="flex items-center border border-zinc-800 rounded-full p-1 text-[11px] font-mono bg-zinc-950/80">
        <a
          href={enUrl}
          class={`px-2.5 py-1 rounded-full transition-all ${
            lang === 'en' ? 'bg-blue-600 text-white font-semibold shadow-sm' : 'text-zinc-400 hover:text-white'
          }`}
        >
          EN
        </a>
        <a
          href={trUrl}
          class={`px-2.5 py-1 rounded-full transition-all ${
            lang === 'tr' ? 'bg-blue-600 text-white font-semibold shadow-sm' : 'text-zinc-400 hover:text-white'
          }`}
        >
          TR
        </a>
      </div>

      <a
        href="#contact"
        class="hidden sm:inline-flex items-center justify-center px-4 py-2 rounded-full text-xs font-mono uppercase tracking-wider bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-500/25 transition-all font-semibold"
      >
        {nav.getInTouch}
      </a>
    </div>
  </div>
</header>
