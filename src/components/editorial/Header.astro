---
interface Props {
  lang?: 'en' | 'tr';
  currentSlug?: string;
}

const { lang = 'en', currentSlug = '' } = Astro.props;

// Determine counterpart URL for language toggle
const enUrl = currentSlug ? `/works/${currentSlug}` : '/';
const trUrl = currentSlug ? `/tr/works/${currentSlug}` : '/tr/';

const nav = {
  en: {
    works: 'Works',
    flagship: 'SiriusSync ITS',
    stack: 'Expertise',
    contact: 'Inquiries',
  },
  tr: {
    works: 'Çalışmalar',
    flagship: 'SiriusSync ITS',
    stack: 'Yetkinlikler',
    contact: 'İletişim',
  },
}[lang];
---

<header class="sticky top-0 z-50 bg-[#050507]/80 backdrop-blur-md hairline-b">
  <div class="max-w-6xl mx-auto px-6 md:px-12 h-20 flex items-center justify-between">
    <!-- Brand / Monogram -->
    <a href={lang === 'en' ? '/' : '/tr/'} class="group flex items-center gap-3">
      <div class="w-8 h-8 rounded-full hairline flex items-center justify-center font-mono text-xs text-white bg-zinc-900 group-hover:bg-white group-hover:text-black transition-colors">
        OI
      </div>
      <div class="flex flex-col">
        <span class="text-sm font-semibold tracking-tight text-white uppercase group-hover:text-zinc-300 transition-colors">
          Onur Işık
        </span>
        <span class="text-[11px] font-mono text-zinc-500 tracking-wider">
          CODER ACJHP
        </span>
      </div>
    </a>

    <!-- Nav Links -->
    <nav class="hidden md:flex items-center gap-8 text-xs font-mono tracking-wider uppercase text-zinc-400">
      <a href="#works" class="hover:text-white transition-colors">{nav.works}</a>
      <a href="#siriussync" class="hover:text-white transition-colors">{nav.flagship}</a>
      <a href="#expertise" class="hover:text-white transition-colors">{nav.stack}</a>
      <a href="#contact" class="hover:text-white transition-colors">{nav.contact}</a>
    </nav>

    <!-- Language Switcher & Direct CTA -->
    <div class="flex items-center gap-4">
      <div class="flex items-center hairline rounded-full p-1 text-[11px] font-mono bg-zinc-950">
        <a
          href={enUrl}
          class={`px-2.5 py-1 rounded-full transition-all ${
            lang === 'en' ? 'bg-white text-black font-semibold' : 'text-zinc-500 hover:text-white'
          }`}
        >
          EN
        </a>
        <a
          href={trUrl}
          class={`px-2.5 py-1 rounded-full transition-all ${
            lang === 'tr' ? 'bg-white text-black font-semibold' : 'text-zinc-500 hover:text-white'
          }`}
        >
          TR
        </a>
      </div>

      <a
        href="#contact"
        class="hidden sm:inline-flex items-center justify-center px-4 py-2 rounded-full text-xs font-mono uppercase tracking-wider hairline bg-white text-black hover:bg-zinc-200 transition-all font-semibold"
      >
        {lang === 'en' ? 'Get in Touch' : 'İletişime Geç'}
      </a>
    </div>
  </div>
</header>

