---
interface Props {
  lang?: 'en' | 'tr';
}

const { lang = 'en' } = Astro.props;

const t = {
  en: {
    backToTop: 'BACK TO TOP ↑',
    legal: 'LEGAL & ARCHIVE',
    changelog: 'Changelog v1.5.5',
    privacy: 'Privacy Policy',
    terms: 'Terms of Use',
    support: 'Support Hub',
    admin: 'Admin Console',
    copyNotice: '© 2026 Onur Işık (Coder ACJHP). All rights reserved.',
    subNotice: 'Swiss editorial design & production-grade architecture deployed on Cloudflare Pages.',
  },
  tr: {
    backToTop: 'BAŞA DÖN ↑',
    legal: 'YASAL & ARŞİV',
    changelog: 'Sürüm Notları v1.5.5',
    privacy: 'Gizlilik Politikası',
    terms: 'Kullanım Koşulları',
    support: 'Destek Portalı',
    admin: 'Yönetim Paneli',
    copyNotice: '© 2026 Onur Işık (Coder ACJHP). Tüm hakları saklıdır.',
    subNotice: 'İsviçre editoryal tasarım & Cloudflare Pages üzerinde yayınlanan kurumsal mimari.',
  },
}[lang];
---

<footer class="py-16 px-6 md:px-12 bg-black hairline-t">
  <div class="max-w-6xl mx-auto">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between pb-12 mb-12 hairline-b gap-8">
      <div>
        <span class="text-xl font-editorial tracking-tight text-white block mb-1">
          Onur Işık — Software Studio
        </span>
        <span class="text-xs font-mono text-zinc-500 uppercase tracking-widest">
          CODER ACJHP • SENIOR MOBILE & ENTERPRISE ARCHITECT
        </span>
      </div>

      <a
        href="#"
        class="text-xs font-mono tracking-widest text-zinc-400 hover:text-white transition-colors"
      >
        {t.backToTop}
      </a>
    </div>

    <!-- Legal and Preserved App Endpoints Footer Navigation -->
    <div class="flex flex-wrap items-center justify-between gap-6 text-xs font-mono text-zinc-500 pb-12 hairline-b">
      <div class="flex flex-wrap items-center gap-6">
        <span class="text-zinc-600 font-bold">{t.legal}:</span>
        <a href="/projects/siriussync/docs/change-log.html" target="_blank" class="hover:text-zinc-300 transition-colors">
          {t.changelog}
        </a>
        <a href="/projects/siriussync/privacy-policy.html" target="_blank" class="hover:text-zinc-300 transition-colors">
          {t.privacy}
        </a>
        <a href="/projects/siriussync/terms-of-use.html" target="_blank" class="hover:text-zinc-300 transition-colors">
          {t.terms}
        </a>
        <a href="/projects/siriussync/support.html" target="_blank" class="hover:text-zinc-300 transition-colors">
          {t.support}
        </a>
        <a href="/projects/siriussync/admin.html" target="_blank" class="hover:text-zinc-300 transition-colors">
          {t.admin}
        </a>
      </div>

      <div class="flex items-center gap-6">
        <a href="https://stackoverflow.com/users/coder-acjhp" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
          Stack Overflow
        </a>
        <a href="https://github.com/Coder-ACJHP" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
          GitHub
        </a>
        <a href="https://bionluk.com/coderacjhp" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
          Bionluk
        </a>
        <a href="https://www.linkedin.com/in/bilal-khalid-mohammed-ameen-70663212b/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
          LinkedIn
        </a>
      </div>
    </div>

    <div class="pt-8 flex flex-col sm:flex-row items-start sm:items-center justify-between text-[11px] font-mono text-zinc-600 gap-4">
      <span>{t.copyNotice}</span>
      <span>{t.subNotice}</span>
    </div>
  </div>
</footer>

