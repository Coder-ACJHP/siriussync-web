---
interface Props {
  lang?: 'en' | 'tr';
}

const { lang = 'en' } = Astro.props;

const t = {
  en: {
    backToTop: 'BACK TO TOP ↑',
    copyNotice: '© 2026 Onur Işık (Coder ACJHP). All rights reserved.',
    subNotice: 'Made with love by Coder ACJHP',
  },
  tr: {
    backToTop: 'BAŞA DÖN ↑',
    copyNotice: '© 2026 Onur Işık (Coder ACJHP). Tüm hakları saklıdır.',
    subNotice: 'Made with love by Coder ACJHP',
  },
}[lang];
---

<footer class="py-8 px-6 md:px-12 bg-[#05070b] border-t border-zinc-800/80">
  <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between text-xs font-mono text-zinc-400 gap-4">
    <span>{t.copyNotice}</span>
    <span class="text-cyan-400 font-medium">{t.subNotice}</span>
    <a
      href="#"
      class="tracking-widest text-zinc-400 hover:text-white transition-colors"
    >
      {t.backToTop}
    </a>
  </div>
</footer>
