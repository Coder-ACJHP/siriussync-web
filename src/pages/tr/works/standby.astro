---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/editorial/Header.astro';
import Footer from '../../../components/editorial/Footer.astro';
import CircularCarousel from '../../../components/editorial/CircularCarousel';
import { ArrowLeft, Clock, Moon, ArrowUpRight, Music, Globe } from 'lucide-react';

const carouselImages = [
  { src: '/assets/images/standby/flip.webp', alt: 'Classic Flip Clock' },
  { src: '/assets/images/standby/dottedmap.webp', alt: 'Dotted World Map' },
  { src: '/assets/images/standby/calendar.webp', alt: 'Calendar & Reminders' },
  { src: '/assets/images/standby/stars.webp', alt: 'Star Constellation' },
  { src: '/assets/images/standby/photos.webp', alt: 'Photos Clock' },
  { src: '/assets/images/standby/butterflies.webp', alt: 'Butterflies' },
  { src: '/assets/images/standby/western.webp', alt: 'Country Western' },
  { src: '/assets/images/standby/gradient.webp', alt: 'Gradient Float' },
];
---

<BaseLayout
  lang="tr"
  title="StandBy Clock — Native iOS & iPadOS Vitrin | Onur Işık"
  description="StandBy Clock - Night Display: 17+ özel saat yüzü, 72 dakikalık çevrimdışı uyku sesleri ve Clean Architecture UIKit mimarisine sahip masaüstü ve komodin saati."
>
  <Header lang="tr" currentSlug="standby" />

  <main class="py-16 md:py-24 px-6 md:px-12 bg-[#07090e]">
    <div class="max-w-5xl mx-auto">
      <!-- Breadcrumb / Back Link -->
      <a href="/tr/#works" class="inline-flex items-center gap-2 text-xs font-mono tracking-widest text-zinc-400 hover:text-white uppercase mb-8 transition-colors">
        <ArrowLeft className="w-3.5 h-3.5" />
        <span>Çalışmalara Dön</span>
      </a>

      <!-- Case Study Hero -->
      <div class="mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-cyan-500/10 border border-cyan-500/25 text-cyan-400 font-semibold uppercase tracking-wider mb-6">
          <span>NATIVE IOS & IPADOS UYGULAMASI • 17+ TEMA • v1.2.4</span>
        </div>
        <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-white leading-tight mb-6">
          StandBy Clock: Masaüstü İçin Minimalist Ergonomik Saat
        </h1>
        <p class="text-lg md:text-xl text-zinc-300 font-normal max-w-3xl leading-relaxed">
          iPhone ve iPad cihazınızı dikkat dağıtmayan, seçkin ve estetik bir masaüstü/gece saatine dönüştürür. 17+ farklı temasıyla, her saate özel renk paletiyle ve düşük güç tüketimli render algoritmaları sayesinde cihazınızı şarja takma zorunluğu olmadan masaüstü saatine çevirin.
        </p>
      </div>

      <!-- Quick Metrics Strip -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-6 rounded-2xl border border-zinc-800 bg-[#0c121e] mb-12 text-xs font-mono">
        <div>
          <span class="text-zinc-400 uppercase block mb-1">ARAYÜZLER</span>
          <span class="text-white font-bold">17+ Özel Saat Teması</span>
        </div>
        <div>
          <span class="text-zinc-400 uppercase block mb-1">MİMARİ & TEKNOLOJİ</span>
          <span class="text-cyan-400 font-bold">Programmatic UIKit</span>
        </div>
        <div>
          <span class="text-zinc-400 uppercase block mb-1">UYKU VE SES</span>
          <span class="text-blue-400 font-bold">72 dk Çevrimdışı Müzik</span>
        </div>
        <div>
          <span class="text-zinc-400 uppercase block mb-1">APP STORE</span>
          <span class="text-white font-bold">$1.99 • iOS 17.0+</span>
        </div>
      </div>

      <!-- Hero Image -->
      <div class="rounded-3xl border border-zinc-800 overflow-hidden bg-zinc-950 p-3 mb-8 shadow-2xl">
        <img
          src="/assets/images/standby.webp"
          alt="StandBy Clock Görünümü"
          class="w-full h-auto rounded-2xl object-cover"
        />
      </div>

      <!-- Circular 3D Carousel Showcase (Pure Visual, No Sub-Text) -->
      <div class="mb-16">
        <CircularCarousel client:visible images={carouselImages} />
      </div>

      <!-- Details -->
      <div class="space-y-16">
        <section class="border-t border-zinc-800 pt-12">
          <span class="text-xs font-mono uppercase tracking-widest text-cyan-400 font-bold block mb-3">01 / TASARIM FELSEFESİ</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white mb-4">
            Sıfır Parlama, Saf İşlevsellik
          </h2>
          <p class="text-sm sm:text-base text-zinc-300 font-normal leading-relaxed mb-6">
            StandBy Clock, gereksiz bildirim kirliliğini ortadan kaldırarak ekranı en saf haline getirir. <code class="text-cyan-400 bg-zinc-900 px-1.5 py-0.5 rounded font-mono text-xs">DeviceScreenManager</code> ile yönetilen akıllı karartma sayesinde uygulama aktifken ekran kapanma zamanlayıcısı devreden çıkar; uygulama arka plana alındığı veya kapatıldığı anda kullanıcının orijinal parlaklık ve otomatik kilit ayarları eksiksiz geri yüklenir.
          </p>
        </section>

        <!-- Features Grid -->
        <section class="border-t border-zinc-800 pt-12">
          <span class="text-xs font-mono uppercase tracking-widest text-blue-400 font-bold block mb-3">02 / ÇEKİRDEK YETENEKLER & MİMARİ</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white mb-8">
            Hassas Mühendislik & Clean Architecture
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="p-6 rounded-2xl border border-zinc-800 bg-[#0c121e] space-y-3">
              <div class="w-10 h-10 rounded-xl border border-cyan-500/30 flex items-center justify-center bg-cyan-500/10 text-cyan-400">
                <Clock className="w-5 h-5 text-cyan-400" />
              </div>
              <h3 class="text-lg font-mono font-bold text-white">17+ Seçkin Saat Arayüzü</h3>
              <p class="text-xs text-zinc-300 font-normal leading-relaxed">
                Mekanik yaprak saat (Flip Clock) animasyonundan noktalı dünya haritasına, takımyıldızlardan Ken Burns efektli fotoğraflara ve EventKit hatırlatıcılı takvim ekranına kadar zengin koleksiyon. Factory ve <code class="text-zinc-400 font-mono text-[11px]">ClockTimeSourceProtocol</code> ile senkronize yönetim.
              </p>
            </div>

            <div class="p-6 rounded-2xl border border-zinc-800 bg-[#0c121e] space-y-3">
              <div class="w-10 h-10 rounded-xl border border-blue-500/30 flex items-center justify-center bg-blue-500/10 text-blue-400">
                <Music className="w-5 h-5 text-blue-400" />
              </div>
              <h3 class="text-lg font-mono font-bold text-white">72 Dk Çevrimdışı Uyku Sesleri</h3>
              <p class="text-xs text-zinc-300 font-normal leading-relaxed">
                İnternet bağlantısı gerektirmeyen hazır dinlendirici ambient müzikler. Ayrıca Apple Music arşivinden kişisel parçaları içe aktarma, arka planda çalma ve Kilit Ekranı/Denetim Merkezi entegrasyonu.
              </p>
            </div>

            <div class="p-6 rounded-2xl border border-zinc-800 bg-[#0c121e] space-y-3">
              <div class="w-10 h-10 rounded-xl border border-indigo-500/30 flex items-center justify-center bg-indigo-500/10 text-indigo-400">
                <Globe className="w-5 h-5 text-indigo-400" />
              </div>
              <h3 class="text-lg font-mono font-bold text-white">Gündüz/Gece Güneş Sınırı ve Hava</h3>
              <p class="text-xs text-zinc-300 font-normal leading-relaxed">
                GeoJSON tabanlı noktalı dünya haritası üzerinde gün ışığı hareketini anlık hesaplayan terminatör çizgisi, CoreLocation konum tespiti ve Open-Meteo ile yerel hava durumu gösterimi.
              </p>
            </div>

            <div class="p-6 rounded-2xl border border-zinc-800 bg-[#0c121e] space-y-3">
              <div class="w-10 h-10 rounded-xl border border-emerald-500/30 flex items-center justify-center bg-emerald-500/10 text-emerald-400">
                <Moon className="w-5 h-5 text-emerald-400" />
              </div>
              <h3 class="text-lg font-mono font-bold text-white">OLED Yanma Koruması</h3>
              <p class="text-xs text-zinc-300 font-normal leading-relaxed">
                Cihaz tüm gece stand üzerinde açık kaldığında ekran panelinin ömrünü korumak için fark edilmeyen periyodik mikro piksel kaydırmaları ve düşük emisyonlu gece renk paletleri.
              </p>
            </div>
          </div>
        </section>

        <!-- CTA Section -->
        <section class="border-t border-zinc-800 pt-12 pb-8">
          <div class="p-8 md:p-12 rounded-3xl border border-blue-500/25 bg-gradient-to-r from-[#0d1627] via-[#090d16] to-[#07090e] flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
            <div class="space-y-3">
              <span class="text-xs font-mono uppercase tracking-widest text-cyan-400 font-bold block">
                APP STORE YAYINI
              </span>
              <h3 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">
                StandBy Clock'u iOS & iPadOS'ta Deneyimleyin
              </h3>
              <p class="text-xs sm:text-sm text-zinc-300 font-normal max-w-xl">
                Tek seferlik satın alma ($1.99), abonelik veya takip içermez. iOS 17.0 ve üzeri yüklü iPhone ve iPad modelleriyle tam uyumludur.
              </p>
            </div>

            <a
              href="https://apps.apple.com/us/app/standby-clock-night-display/id6766165559"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full text-xs font-mono uppercase tracking-wider bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-600/30 transition-all font-bold shrink-0"
            >
              <span>App Store'da İncele</span>
              <ArrowUpRight className="w-4 h-4" />
            </a>
          </div>
        </section>
      </div>
    </div>
  </main>

  <Footer lang="tr" />
</BaseLayout>
