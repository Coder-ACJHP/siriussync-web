---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/editorial/Header.astro';
import Footer from '../../../components/editorial/Footer.astro';
import { Download, ArrowLeft, Shield, Database, Cpu, Lock } from 'lucide-react';

const winUrl = 'https://github.com/Coder-ACJHP/siriussync-releases/releases/download/v1.5.5/SiriusSync.ITS-1.5.5.msi';
const macUrl = 'https://github.com/Coder-ACJHP/siriussync-releases/releases/download/v1.5.5/SiriusSync.ITS-1.5.5.dmg';
---

<BaseLayout
  lang="tr"
  title="SiriusSync ITS — Kurumsal Mimari & Vaka Analizi | Onur Işık"
  description="SiriusSync ITS detaylı sistem analizi: JavaFX ve Supabase Realtime ile geliştirilmiş reaktif kurumsal masaüstü ERP."
>
  <Header lang="tr" currentSlug="siriussync" />

  <main class="py-16 md:py-24 px-6 md:px-12">
    <div class="max-w-5xl mx-auto">
      <!-- Breadcrumb / Back Link -->
      <a href="/tr/#siriussync" class="inline-flex items-center gap-2 text-xs font-mono tracking-widest text-zinc-500 hover:text-white uppercase mb-8 transition-colors">
        <ArrowLeft className="w-3.5 h-3.5" />
        <span>Stüdyo Özetine Dön</span>
      </a>

      <!-- Case Study Hero -->
      <div class="mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-white text-black font-semibold uppercase tracking-wider mb-6">
          <span>AMİRAL GEMİSİ MİMARİSİ • v1.5.5 CANLI</span>
        </div>
        <h1 class="text-4xl sm:text-6xl md:text-7xl font-editorial tracking-tight text-white leading-tight mb-6">
          SiriusSync ITS: Yüksek Performanslı Masaüstü Kurumsal ERP
        </h1>
        <p class="text-lg md:text-xl text-zinc-400 font-light max-w-3xl leading-relaxed">
          Masaüstü hızını bulutun esnekliğiyle birleştirmek üzere geliştirildi. SiriusSync ITS, gerçek zamanlı çoklu terminal envanter senkronizasyonu, CRM ve kriptografik lisans doğrulama sağlar.
        </p>
      </div>

      <!-- Quick Metrics Strip -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-6 rounded-2xl hairline bg-[#08080a] mb-12 text-xs font-mono">
        <div>
          <span class="text-zinc-500 uppercase block mb-1">ÇALIŞMA ORTAMI</span>
          <span class="text-white font-bold">Java 21 LTS (Modüler)</span>
        </div>
        <div>
          <span class="text-zinc-500 uppercase block mb-1">VERİTABANI</span>
          <span class="text-white font-bold">Supabase Realtime Postgres</span>
        </div>
        <div>
          <span class="text-zinc-500 uppercase block mb-1">GÜVENLİK</span>
          <span class="text-white font-bold">Bcrypt + RLS İlkeleri</span>
        </div>
        <div>
          <span class="text-zinc-500 uppercase block mb-1">PLATFORM</span>
          <span class="text-white font-bold">macOS & Windows</span>
        </div>
      </div>

      <!-- Hero Image -->
      <div class="rounded-3xl hairline overflow-hidden bg-zinc-950 p-3 mb-16 shadow-2xl">
        <img
          src="/assets/images/siriussync.png"
          alt="SiriusSync ITS Arayüzü"
          class="w-full h-auto rounded-2xl object-cover"
        />
      </div>

      <!-- Executive Overview -->
      <div class="space-y-16">
        <section class="hairline-t pt-12">
          <span class="text-xs font-mono uppercase tracking-widest text-zinc-500 block mb-3">01 / PROBLEM VE İHTİYAÇ</span>
          <h2 class="text-2xl sm:text-3xl font-editorial text-white mb-4">
            Modern ERP Sistemlerinde Gecikme ve İzolasyon Sorunu
          </h2>
          <p class="text-sm sm:text-base text-zinc-400 font-light leading-relaxed mb-6">
            Geleneksel web tabanlı ERP yazılımları, yoğun barkod okuma ve depo girişlerinde arayüz gecikmeleri ve DOM render maliyetleri yaşar. Buna karşın eski masaüstü yazılımları ise çoklu lokasyonda anlık veri senkronizasyonu sağlayamaz.
          </p>
          <p class="text-sm sm:text-base text-zinc-400 font-light leading-relaxed">
            SiriusSync ITS; JavaFX'in native çalışma gücü ve Supabase Realtime'ın WebSocket altyapısı birleştirilerek tüm terminaller arasında 50 milisaniyenin altında veri senkronizasyonu sunmak üzere tasarlandı.
          </p>
        </section>

        <!-- Technical Modules Grid -->
        <section class="hairline-t pt-12">
          <span class="text-xs font-mono uppercase tracking-widest text-zinc-500 block mb-3">02 / ÇEKİRDEK ALT SİSTEMLER</span>
          <h2 class="text-2xl sm:text-3xl font-editorial text-white mb-8">
            Mimari Modüller ve İş Akışları
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="p-6 rounded-2xl hairline bg-[#08080a] space-y-3">
              <div class="w-10 h-10 rounded-xl hairline flex items-center justify-center bg-zinc-900 text-white">
                <Database className="w-5 h-5 text-emerald-400" />
              </div>
              <h3 class="text-lg font-mono font-bold text-white">Gerçek Zamanlı Envanter Senkronizasyonu</h3>
              <p class="text-xs text-zinc-400 font-light leading-relaxed">
                Supabase PostgreSQL üzerindeki değişiklikler kalıcı WebSocket bağlantıları sayesinde tüm aktif depo terminallerine manuel yenileme gerekmeden anında yansıtılır.
              </p>
            </div>

            <div class="p-6 rounded-2xl hairline bg-[#08080a] space-y-3">
              <div class="w-10 h-10 rounded-xl hairline flex items-center justify-center bg-zinc-900 text-white">
                <Cpu className="w-5 h-5 text-blue-400" />
              </div>
              <h3 class="text-lg font-mono font-bold text-white">POM & SOM Sipariş Yaşam Döngüsü</h3>
              <p class="text-xs text-zinc-400 font-light leading-relaxed">
                Satın Alma Sipariş Yönetimi (POM) ve Satış Sipariş Yönetimi (SOM) modülleri; maliyet hesaplamaları, fatura mutabakatı ve ürün yaşam döngüsünü otomatikleştirir.
              </p>
            </div>

            <div class="p-6 rounded-2xl hairline bg-[#08080a] space-y-3">
              <div class="w-10 h-10 rounded-xl hairline flex items-center justify-center bg-zinc-900 text-white">
                <Lock className="w-5 h-5 text-indigo-400" />
              </div>
              <h3 class="text-lg font-mono font-bold text-white">Donanıma Bağlı (HWID) Lisanslama</h3>
              <p class="text-xs text-zinc-400 font-light leading-relaxed">
                Kriptografik cihaz donanım kimliği ile kurulumlar yetkili iş istasyonlarına kilitlenir. Modül yetkileri ve lisans durumları entegre admin panelinden anlık olarak yönetilir.
              </p>
            </div>

            <div class="p-6 rounded-2xl hairline bg-[#08080a] space-y-3">
              <div class="w-10 h-10 rounded-xl hairline flex items-center justify-center bg-zinc-900 text-white">
                <Shield className="w-5 h-5 text-amber-400" />
              </div>
              <h3 class="text-lg font-mono font-bold text-white">Katı Row Level Security (RLS)</h3>
              <p class="text-xs text-zinc-400 font-light leading-relaxed">
                PostgreSQL seviyesinde uygulanan veri erişim politikaları, çok kiracılı kurumsal kullanımda verilerin birbirine karışmasını motor düzeyinde engeller.
              </p>
            </div>
          </div>
        </section>

        <!-- Live Version & Production Artifacts -->
        <section class="hairline-t pt-12 pb-8">
          <div class="p-8 md:p-12 rounded-3xl hairline bg-[#08080a] flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
            <div class="space-y-3">
              <span class="text-xs font-mono uppercase tracking-widest text-emerald-400 font-semibold block">
                CANLI SÜRÜM DOSYALARI • v1.5.5
              </span>
              <h3 class="text-2xl sm:text-3xl font-editorial text-white">
                SiriusSync ITS'i Canlı Ortamda Deneyin
              </h3>
              <p class="text-xs sm:text-sm text-zinc-400 font-light max-w-xl">
                Windows (.msi) ve macOS (.dmg) paketleri yayında. Otomatik açılış desteği, yapılandırılabilir çalışma alanı ve dahili rehber içerir.
              </p>
            </div>

            <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto shrink-0">
              <a
                href={winUrl}
                class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full text-xs font-mono uppercase tracking-wider bg-white text-black hover:bg-zinc-200 transition-all font-semibold"
              >
                <Download className="w-4 h-4" />
                <span>Windows İçin İndir</span>
              </a>
              <a
                href={macUrl}
                class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full text-xs font-mono uppercase tracking-wider hairline text-zinc-300 hover:text-white hover:border-white/40 transition-all font-medium"
              >
                <Download className="w-4 h-4" />
                <span>macOS İçin İndir</span>
              </a>
            </div>
          </div>
        </section>
      </div>
    </div>
  </main>

  <Footer lang="tr" />
</BaseLayout>

