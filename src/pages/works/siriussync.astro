---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/editorial/Header.astro';
import Footer from '../../components/editorial/Footer.astro';
import { Download, ArrowLeft, Shield, Database, Cpu, Lock } from 'lucide-react';

const winUrl = 'https://github.com/Coder-ACJHP/siriussync-releases/releases/download/v1.5.5/SiriusSync.ITS-1.5.5.msi';
const macUrl = 'https://github.com/Coder-ACJHP/siriussync-releases/releases/download/v1.5.5/SiriusSync.ITS-1.5.5.dmg';
---

<BaseLayout
  lang="en"
  title="SiriusSync ITS — Yeni Nesil Masaüstü ERP | Onur Işık"
  description="In-depth architectural breakdown of SiriusSync ITS: A reactive enterprise desktop ERP powered by JavaFX and Supabase Realtime."
>
  <Header lang="en" currentSlug="siriussync" />

  <main class="py-16 md:py-24 px-6 md:px-12 bg-[#07090e]">
    <div class="max-w-5xl mx-auto">
      <!-- Breadcrumb / Back Link -->
      <a href="/#works" class="inline-flex items-center gap-2 text-xs font-mono tracking-widest text-zinc-400 hover:text-white uppercase mb-8 transition-colors">
        <ArrowLeft className="w-3.5 h-3.5" />
        <span>Return to Overview</span>
      </a>

      <!-- Case Study Hero -->
      <div class="mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-blue-500/10 border border-blue-500/25 text-blue-400 font-semibold uppercase tracking-wider mb-6">
          <span>DESKTOP ERP • v1.5.5 PRODUCTION</span>
        </div>
        <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-white leading-tight mb-6">
          SiriusSync ITS: High-Concurrency Enterprise Desktop ERP
        </h1>
        <p class="text-lg md:text-xl text-zinc-300 font-normal max-w-3xl leading-relaxed">
          Engineered to bridge deterministic desktop reliability with cloud elasticity. SiriusSync ITS provides real-time multi-terminal inventory synchronization, unified CRM contact lifecycles, and cryptographic license verification.
        </p>
      </div>

      <!-- Quick Metrics Strip -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-6 rounded-2xl border border-zinc-800 bg-[#0c121e] mb-12 text-xs font-mono">
        <div>
          <span class="text-zinc-400 uppercase block mb-1">RUNTIME</span>
          <span class="text-white font-bold">Java 21 LTS (Modular)</span>
        </div>
        <div>
          <span class="text-zinc-400 uppercase block mb-1">DATABASE</span>
          <span class="text-cyan-400 font-bold">Supabase Realtime Postgres</span>
        </div>
        <div>
          <span class="text-zinc-400 uppercase block mb-1">SECURITY</span>
          <span class="text-blue-400 font-bold">Bcrypt + RLS Policies</span>
        </div>
        <div>
          <span class="text-zinc-400 uppercase block mb-1">PLATFORMS</span>
          <span class="text-white font-bold">macOS & Windows</span>
        </div>
      </div>

      <!-- Hero Image -->
      <div class="rounded-3xl border border-zinc-800 overflow-hidden bg-zinc-950 p-3 mb-16 shadow-2xl">
        <img
          src="/assets/images/siriussync.png"
          alt="SiriusSync ITS Interface"
          class="w-full h-auto rounded-2xl object-cover"
        />
      </div>

      <!-- Overview -->
      <div class="space-y-16">
        <section class="border-t border-zinc-800 pt-12">
          <span class="text-xs font-mono uppercase tracking-widest text-blue-400 font-bold block mb-3">01 / ARCHITECTURAL GOALS</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white mb-4">
            Deterministic Native Speed Meets Distributed Cloud Persistence
          </h2>
          <p class="text-sm sm:text-base text-zinc-300 font-normal leading-relaxed mb-6">
            Traditional web ERP systems suffer from UI latency, connection instability during high-frequency barcode scanning, and unpredictable DOM redraw overhead. Conversely, legacy desktop software creates data silos that fail to synchronize across distributed warehouses in real-time.
          </p>
          <p class="text-sm sm:text-base text-zinc-300 font-normal leading-relaxed">
            SiriusSync ITS was engineered from first principles using JavaFX and Supabase Realtime to deliver zero-friction native execution speed with sub-50ms distributed database updates across all concurrent terminals.
          </p>
        </section>

        <!-- Technical Modules Grid -->
        <section class="border-t border-zinc-800 pt-12">
          <span class="text-xs font-mono uppercase tracking-widest text-cyan-400 font-bold block mb-3">02 / CORE SUBSYSTEMS</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white mb-8">
            Architectural Modules & Lifecycle Pipelines
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="p-6 rounded-2xl border border-zinc-800 bg-[#0c121e] space-y-3">
              <div class="w-10 h-10 rounded-xl border border-blue-500/30 flex items-center justify-center bg-blue-500/10 text-blue-400">
                <Database className="w-5 h-5 text-blue-400" />
              </div>
              <h3 class="text-lg font-mono font-bold text-white">Real-Time Inventory Synchronization</h3>
              <p class="text-xs text-zinc-300 font-normal leading-relaxed">
                Persistent WebSocket subscriptions with Supabase PostgreSQL broadcast inventory quantity changes and state updates immediately across all active warehouse workstations without manual refreshes.
              </p>
            </div>

            <div class="p-6 rounded-2xl border border-zinc-800 bg-[#0c121e] space-y-3">
              <div class="w-10 h-10 rounded-xl border border-cyan-500/30 flex items-center justify-center bg-cyan-500/10 text-cyan-400">
                <Cpu className="w-5 h-5 text-cyan-400" />
              </div>
              <h3 class="text-lg font-mono font-bold text-white">POM & SOM Lifecycle Pipelines</h3>
              <p class="text-xs text-zinc-300 font-normal leading-relaxed">
                Full-cycle Purchase Order Management (POM) and Sales Order Management (SOM) workflows, featuring cost-sheet calculation, automated receipt processing, and accounting balance reconciliation.
              </p>
            </div>

            <div class="p-6 rounded-2xl border border-zinc-800 bg-[#0c121e] space-y-3">
              <div class="w-10 h-10 rounded-xl border border-indigo-500/30 flex items-center justify-center bg-indigo-500/10 text-indigo-400">
                <Lock className="w-5 h-5 text-indigo-400" />
              </div>
              <h3 class="text-lg font-mono font-bold text-white">Hardware-Bound (HWID) Licensing</h3>
              <p class="text-xs text-zinc-300 font-normal leading-relaxed">
                Cryptographic hardware fingerprinting binds installations to authorized workstations. Licenses and enabled feature modules can be managed dynamically in real-time via the integrated admin portal.
              </p>
            </div>

            <div class="p-6 rounded-2xl border border-zinc-800 bg-[#0c121e] space-y-3">
              <div class="w-10 h-10 rounded-xl border border-emerald-500/30 flex items-center justify-center bg-emerald-500/10 text-emerald-400">
                <Shield className="w-5 h-5 text-emerald-400" />
              </div>
              <h3 class="text-lg font-mono font-bold text-white">Strict Row Level Security (RLS)</h3>
              <p class="text-xs text-zinc-300 font-normal leading-relaxed">
                PostgreSQL policies enforce strict multi-tenant boundary checks directly at the database engine level, ensuring zero cross-tenant contamination even across complex concurrent queries.
              </p>
            </div>
          </div>
        </section>

        <!-- Live Version & Production Artifacts -->
        <section class="border-t border-zinc-800 pt-12 pb-8">
          <div class="p-8 md:p-12 rounded-3xl border border-blue-500/25 bg-gradient-to-r from-[#0d1627] via-[#090d16] to-[#07090e] flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
            <div class="space-y-3">
              <span class="text-xs font-mono uppercase tracking-widest text-cyan-400 font-bold block">
                PRODUCTION ARTIFACTS • v1.5.5
              </span>
              <h3 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">
                Deploy SiriusSync ITS in Production
              </h3>
              <p class="text-xs sm:text-sm text-zinc-300 font-normal max-w-xl">
                Ready for deployment on Windows (.msi) and macOS (.dmg). Auto-startup capabilities, configurable workspace preferences, and integrated documentation included.
              </p>
            </div>

            <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto shrink-0">
              <a
                href={winUrl}
                class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full text-xs font-mono uppercase tracking-wider bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-600/30 transition-all font-bold"
              >
                <Download className="w-4 h-4" />
                <span>Download for Windows</span>
              </a>
              <a
                href={macUrl}
                class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full text-xs font-mono uppercase tracking-wider border border-zinc-700 bg-zinc-900/60 hover:bg-zinc-800 text-zinc-200 hover:text-white transition-all font-medium"
              >
                <Download className="w-4 h-4" />
                <span>Download for macOS</span>
              </a>
            </div>
          </div>
        </section>
      </div>
    </div>
  </main>

  <Footer lang="en" />
</BaseLayout>
