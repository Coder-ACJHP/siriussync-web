---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/editorial/Header.astro';
import Footer from '../../components/editorial/Footer.astro';
import { ArrowLeft, Clock, Moon, ArrowUpRight } from 'lucide-react';
---

<BaseLayout
  lang="en"
  title="StandBy Clock — Native iOS Showcase | Onur Işık"
  description="StandBy Clock: A minimalist bedside clock with 14+ bespoke interface faces engineered in SwiftUI and UIKit."
>
  <Header lang="en" currentSlug="standby" />

  <main class="py-16 md:py-24 px-6 md:px-12 bg-[#07090e]">
    <div class="max-w-5xl mx-auto">
      <!-- Breadcrumb / Back Link -->
      <a href="/#works" class="inline-flex items-center gap-2 text-xs font-mono tracking-widest text-zinc-400 hover:text-white uppercase mb-8 transition-colors">
        <ArrowLeft className="w-3.5 h-3.5" />
        <span>Return to Works</span>
      </a>

      <!-- Case Study Hero -->
      <div class="mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-cyan-500/10 border border-cyan-500/25 text-cyan-400 font-semibold uppercase tracking-wider mb-6">
          <span>NATIVE IOS UTILITY • 14+ THEMES</span>
        </div>
        <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-white leading-tight mb-6">
          StandBy Clock: Minimalist Ergonomics for the Nightstand
        </h1>
        <p class="text-lg md:text-xl text-zinc-300 font-normal max-w-3xl leading-relaxed">
          Crafted to transform your device into an elegant, distraction-free bedside companion. Built using native SwiftUI and low-power rendering routines.
        </p>
      </div>

      <!-- Quick Metrics Strip -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-6 rounded-2xl border border-zinc-800 bg-[#0c121e] mb-12 text-xs font-mono">
        <div>
          <span class="text-zinc-400 uppercase block mb-1">INTERFACES</span>
          <span class="text-white font-bold">14+ Curated Clock Faces</span>
        </div>
        <div>
          <span class="text-zinc-400 uppercase block mb-1">TECH STACK</span>
          <span class="text-cyan-400 font-bold">SwiftUI & UIKit</span>
        </div>
        <div>
          <span class="text-zinc-400 uppercase block mb-1">OPTIMIZATION</span>
          <span class="text-blue-400 font-bold">OLED Low-Power Night Mode</span>
        </div>
        <div>
          <span class="text-zinc-400 uppercase block mb-1">AUTOMATION</span>
          <span class="text-white font-bold">Fastlane CI/CD</span>
        </div>
      </div>

      <!-- Hero Image -->
      <div class="rounded-3xl border border-zinc-800 overflow-hidden bg-zinc-950 p-3 mb-16 shadow-2xl">
        <img
          src="/assets/images/standby.jpg"
          alt="StandBy Clock Showcase"
          class="w-full h-auto rounded-2xl object-cover"
        />
      </div>

      <!-- Details -->
      <div class="space-y-16">
        <section class="border-t border-zinc-800 pt-12">
          <span class="text-xs font-mono uppercase tracking-widest text-cyan-400 font-bold block mb-3">01 / DESIGN PHILOSOPHY</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white mb-4">
            Zero Glare, Pure Utility
          </h2>
          <p class="text-sm sm:text-base text-zinc-300 font-normal leading-relaxed mb-6">
            StandBy Clock eliminates modern notification anxiety by stripping bedside displays down to their essence. Featuring an adaptive ultra-red low-emission mode that preserves dark-adapted night vision, users can glance at the time and ambient conditions without sleep disruption.
          </p>
        </section>

        <!-- Features Grid -->
        <section class="border-t border-zinc-800 pt-12">
          <span class="text-xs font-mono uppercase tracking-widest text-blue-400 font-bold block mb-3">02 / CORE ARCHITECTURE</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white mb-8">
            Engineered with Precision
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="p-6 rounded-2xl border border-zinc-800 bg-[#0c121e] space-y-3">
              <div class="w-10 h-10 rounded-xl border border-cyan-500/30 flex items-center justify-center bg-cyan-500/10 text-cyan-400">
                <Clock className="w-5 h-5 text-cyan-400" />
              </div>
              <h3 class="text-lg font-mono font-bold text-white">14+ Typographic Layouts</h3>
              <p class="text-xs text-zinc-300 font-normal leading-relaxed">
                From flip-clock retro aesthetics to contemporary architectural numerals, each theme is precision-calculated to utilize full screen real estate.
              </p>
            </div>

            <div class="p-6 rounded-2xl border border-zinc-800 bg-[#0c121e] space-y-3">
              <div class="w-10 h-10 rounded-xl border border-blue-500/30 flex items-center justify-center bg-blue-500/10 text-blue-400">
                <Moon className="w-5 h-5 text-blue-400" />
              </div>
              <h3 class="text-lg font-mono font-bold text-white">OLED Anti-Burn Protection</h3>
              <p class="text-xs text-zinc-300 font-normal leading-relaxed">
                Micro-pixel shifts periodically cycle digits imperceptibly, ensuring full panel longevity during all-night bedside docking.
              </p>
            </div>
          </div>
        </section>

        <!-- CTA Section -->
        <section class="border-t border-zinc-800 pt-12 pb-8">
          <div class="p-8 md:p-12 rounded-3xl border border-blue-500/25 bg-gradient-to-r from-[#0d1627] via-[#090d16] to-[#07090e] flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
            <div class="space-y-3">
              <span class="text-xs font-mono uppercase tracking-widest text-cyan-400 font-bold block">
                APP STORE PUBLICATION
              </span>
              <h3 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">
                Experience StandBy Clock on iOS
              </h3>
              <p class="text-xs sm:text-sm text-zinc-300 font-normal max-w-xl">
                Compatible with iPhones supporting iOS 16 and later. Seamless docking and orientation lock support.
              </p>
            </div>

            <a
              href="https://apps.apple.com/developer/onur-isik"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full text-xs font-mono uppercase tracking-wider bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-600/30 transition-all font-bold shrink-0"
            >
              <span>View on App Store</span>
              <ArrowUpRight className="w-4 h-4" />
            </a>
          </div>
        </section>
      </div>
    </div>
  </main>

  <Footer lang="en" />
</BaseLayout>
