---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/editorial/Header.astro';
import Footer from '../../components/editorial/Footer.astro';
import CircularCarousel from '../../components/editorial/CircularCarousel';
import { ArrowLeft, Clock, Moon, ArrowUpRight, Music, Globe } from 'lucide-react';

const carouselImages = [
  { src: '/assets/images/standby/flip.webp', alt: 'Classic Flip Clock' },
  { src: '/assets/images/standby/dottedmap.webp', alt: 'Dotted World Map' },
  { src: '/assets/images/standby/calendar.webp', alt: 'Calendar & Reminders' },
  { src: '/assets/images/standby/stars.webp', alt: 'Star Constellation' },
  { src: '/assets/images/standby/photos.webp', alt: 'Photos Clock' },
  { src: '/assets/images/standby/butterflies.webp', alt: 'Butterflies' },
  { src: '/assets/images/standby/western.webp', alt: 'Country Western' },
  { src: '/assets/images/standby/gradient.webp', alt: 'Gradient Float' },
];
---

<BaseLayout
  lang="en"
  title="StandBy Clock — Native iOS & iPadOS Showcase | Onur Işık"
  description="StandBy Clock - Night Display: A minimalist desk and bedside clock featuring 17+ bespoke interface faces, 72-minute offline sleep audio, and Clean Architecture UIKit."
>
  <Header lang="en" currentSlug="standby" />

  <main class="py-16 md:py-24 px-6 md:px-12 bg-[#07090e]">
    <div class="max-w-5xl mx-auto">
      <!-- Breadcrumb / Back Link -->
      <a href="/#works" class="inline-flex items-center gap-2 text-xs font-mono tracking-widest text-zinc-400 hover:text-white uppercase mb-8 transition-colors">
        <ArrowLeft className="w-3.5 h-3.5" />
        <span>Return to Works</span>
      </a>

      <!-- Case Study Hero -->
      <div class="mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-cyan-500/10 border border-cyan-500/25 text-cyan-400 font-semibold uppercase tracking-wider mb-6">
          <span>NATIVE IOS & IPADOS UTILITY • 17+ THEMES • v1.2.4</span>
        </div>
        <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-white leading-tight mb-6">
          StandBy Clock: Minimalist Ergonomic Desk Clock
        </h1>
        <p class="text-lg md:text-xl text-zinc-300 font-normal max-w-3xl leading-relaxed">
          Transforms your iPhone and iPad into a refined, distraction-free desk and bedside clock. With 17+ distinctive themes, custom color palettes for every face, and low-power rendering routines, turn your device into an elegant desk clock without needing to keep it tethered to a charger.
        </p>
      </div>

      <!-- Quick Metrics Strip -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-6 rounded-2xl border border-zinc-800 bg-[#0c121e] mb-12 text-xs font-mono">
        <div>
          <span class="text-zinc-400 uppercase block mb-1">INTERFACES</span>
          <span class="text-white font-bold">17+ Curated Clock Faces</span>
        </div>
        <div>
          <span class="text-zinc-400 uppercase block mb-1">TECH STACK</span>
          <span class="text-cyan-400 font-bold">Programmatic UIKit</span>
        </div>
        <div>
          <span class="text-zinc-400 uppercase block mb-1">SLEEP AUDIO</span>
          <span class="text-blue-400 font-bold">72m Offline Soundscapes</span>
        </div>
        <div>
          <span class="text-zinc-400 uppercase block mb-1">APP STORE</span>
          <span class="text-white font-bold">$1.99 • iOS 17.0+</span>
        </div>
      </div>

      <!-- Hero Image -->
      <div class="rounded-3xl border border-zinc-800 overflow-hidden bg-zinc-950 p-3 mb-8 shadow-2xl">
        <img
          src="/assets/images/standby.webp"
          alt="StandBy Clock Showcase"
          class="w-full h-auto rounded-2xl object-cover"
        />
      </div>

      <!-- Circular 3D Carousel Showcase (Pure Visual, No Sub-Text) -->
      <div class="mb-16">
        <CircularCarousel client:visible images={carouselImages} />
      </div>

      <!-- Details -->
      <div class="space-y-16">
        <section class="border-t border-zinc-800 pt-12">
          <span class="text-xs font-mono uppercase tracking-widest text-cyan-400 font-bold block mb-3">01 / DESIGN PHILOSOPHY</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white mb-4">
            Zero Glare, Pure Utility
          </h2>
          <p class="text-sm sm:text-base text-zinc-300 font-normal leading-relaxed mb-6">
            StandBy Clock eliminates modern notification anxiety by stripping bedside displays down to their essence. With intelligent dimming managed by <code class="text-cyan-400 bg-zinc-900 px-1.5 py-0.5 rounded font-mono text-xs">DeviceScreenManager</code>, the app disables the system idle timer while docked and gracefully restores auto-lock and user brightness the moment the application enters the background.
          </p>
        </section>

        <!-- Features Grid -->
        <section class="border-t border-zinc-800 pt-12">
          <span class="text-xs font-mono uppercase tracking-widest text-blue-400 font-bold block mb-3">02 / CORE CAPABILITIES & ARCHITECTURE</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white mb-8">
            Engineered with Precision & Clean Architecture
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="p-6 rounded-2xl border border-zinc-800 bg-[#0c121e] space-y-3">
              <div class="w-10 h-10 rounded-xl border border-cyan-500/30 flex items-center justify-center bg-cyan-500/10 text-cyan-400">
                <Clock className="w-5 h-5 text-cyan-400" />
              </div>
              <h3 class="text-lg font-mono font-bold text-white">17+ Curated Clock Faces</h3>
              <p class="text-xs text-zinc-300 font-normal leading-relaxed">
                From mechanical Flip Clock animation and dotted world maps to Celestial Constellations, Photos with Ken Burns zooming, and Calendar with EventKit reminders. Managed via a decoupled factory and unified <code class="text-zinc-400 font-mono text-[11px]">ClockTimeSourceProtocol</code>.
              </p>
            </div>

            <div class="p-6 rounded-2xl border border-zinc-800 bg-[#0c121e] space-y-3">
              <div class="w-10 h-10 rounded-xl border border-blue-500/30 flex items-center justify-center bg-blue-500/10 text-blue-400">
                <Music className="w-5 h-5 text-blue-400" />
              </div>
              <h3 class="text-lg font-mono font-bold text-white">72-Min Offline Sleep Audio</h3>
              <p class="text-xs text-zinc-300 font-normal leading-relaxed">
                Integrated soothing audio sessions that require zero streaming. Supports importing user tracks from Apple Music, queueing, shuffle/repeat, and background playback integrated with iOS Lock Screen controls.
              </p>
            </div>

            <div class="p-6 rounded-2xl border border-zinc-800 bg-[#0c121e] space-y-3">
              <div class="w-10 h-10 rounded-xl border border-indigo-500/30 flex items-center justify-center bg-indigo-500/10 text-indigo-400">
                <Globe className="w-5 h-5 text-indigo-400" />
              </div>
              <h3 class="text-lg font-mono font-bold text-white">Solar Terminator & Weather</h3>
              <p class="text-xs text-zinc-300 font-normal leading-relaxed">
                GeoJSON-backed dotted world map computing real-time sunlight and night boundaries on a relaxed cadence, complemented by localized weather context and CoreLocation reverse geocoding.
              </p>
            </div>

            <div class="p-6 rounded-2xl border border-zinc-800 bg-[#0c121e] space-y-3">
              <div class="w-10 h-10 rounded-xl border border-emerald-500/30 flex items-center justify-center bg-emerald-500/10 text-emerald-400">
                <Moon className="w-5 h-5 text-emerald-400" />
              </div>
              <h3 class="text-lg font-mono font-bold text-white">OLED Anti-Burn Protection</h3>
              <p class="text-xs text-zinc-300 font-normal leading-relaxed">
                Imperceptible periodic micro-pixel shifts protect organic display panels during all-night bedside docking, paired with customizable low-emission night palettes and color themes.
              </p>
            </div>
          </div>
        </section>

        <!-- CTA Section -->
        <section class="border-t border-zinc-800 pt-12 pb-8">
          <div class="p-8 md:p-12 rounded-3xl border border-blue-500/25 bg-gradient-to-r from-[#0d1627] via-[#090d16] to-[#07090e] flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
            <div class="space-y-3">
              <span class="text-xs font-mono uppercase tracking-widest text-cyan-400 font-bold block">
                APP STORE PUBLICATION
              </span>
              <h3 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">
                Experience StandBy Clock on iOS & iPadOS
              </h3>
              <p class="text-xs sm:text-sm text-zinc-300 font-normal max-w-xl">
                One-time purchase ($1.99) with no recurring subscriptions or tracking. Compatible with iPhone and iPad running iOS 17.0 or later.
              </p>
            </div>

            <a
              href="https://apps.apple.com/us/app/standby-clock-night-display/id6766165559"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full text-xs font-mono uppercase tracking-wider bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-600/30 transition-all font-bold shrink-0"
            >
              <span>View on App Store</span>
              <ArrowUpRight className="w-4 h-4" />
            </a>
          </div>
        </section>
      </div>
    </div>
  </main>

  <Footer lang="en" />
</BaseLayout>
