---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: 'en' | 'tr';
  currentPath?: string;
}

const {
  title = 'Onur Işık (Coder ACJHP) — Software Studio & Founder Hub',
  description = 'Senior Software Engineer specializing in Native iOS, Enterprise Desktop ERP systems (JavaFX / Supabase), and Intelligent AI Tools.',
  lang = 'en',
  currentPath = '/',
} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth bg-[#050507] text-[#ededed]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🌐</text></svg>" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Onur Işık (Coder ACJHP)" />
    
    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/assets/images/siriussync.png" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="min-h-screen bg-[#050507] text-[#ededed] antialiased selection:bg-white selection:text-black font-sans relative overflow-x-hidden">
    <slot />
  </body>
</html>

